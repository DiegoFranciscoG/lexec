# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.
# Generar secretos: openssl rand -base64 48   (o: mix phx.gen.secret)

# Phoenix
SECRET_KEY_BASE=
PHX_HOST=localhost
PHX_SCHEME=http
PHX_PUBLIC_PORT=4000

# Área de revisión (/admin/revision). Contraseña de al menos 16 caracteres.
ADMIN_USER=
ADMIN_PASSWORD=

# Meilisearch. En local puede ser la misma clave maestra; en producción usa una clave
# de API con permisos solo sobre el índice "paragraphs".
MEILI_MASTER_KEY=
MEILI_API_KEY=

# Modelos locales: bumblebee | none (búsqueda solo por palabras)
EMBEDDINGS_BACKEND=bumblebee
# rules | bumblebee (NER multilingüe además de las reglas)
NER_BACKEND=rules

# Solo para recopilar del portal (mix lexec.harvest). Identificación con contacto.
HARVEST_USER_AGENT=
HARVEST_CONTACT=
