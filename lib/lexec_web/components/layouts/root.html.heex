<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content="Buscador académico de jurisprudencia de la Corte Constitucional del Ecuador, con citas verificables. No es asesoría legal."
    />
    <meta name="robots" content="index, follow" />
    <.live_title default="LEXEC" suffix=" · LEXEC" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/lexec-mark.svg"} />
    <link
      rel="preload"
      href={~p"/fonts/Newsreader-normal-400-latin.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {@inner_content}
  </body>
</html>
